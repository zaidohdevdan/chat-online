# Exemplo de configuração de variáveis de ambiente para Produção (Vercel + Backend Go + Neon PostgreSQL)
# Copie para .env e preencha com segredos gerados com entropia criptográfica (ex: openssl rand -hex 32)

APP_ENV=production
HTTP_ADDR=127.0.0.1:8080

# Banco de dados Neon PostgreSQL (use a string Direct Connection com sslmode=require)
DATABASE_URL=postgres://USUARIO:SENHA@ep-exemplo.us-east-2.aws.neon.tech/neondb?sslmode=require

# Segurança de Sessão e CORS
SESSION_SECRET=ALTERE_PARA_CHAVE_ALEATORIA_DE_PELO_MENOS_32_BYTES
SESSION_TTL_HOURS=24
SECURE_COOKIES=true
# Use "none" quando o frontend (Vercel) e o backend estiverem em domínios diferentes, ou "lax" no mesmo domínio
COOKIE_SAME_SITE=none
ALLOWED_ORIGINS=https://seu-app.vercel.app,https://*.vercel.app

# Armazenamento e Bundle Estático
UPLOAD_STORAGE_DIR=/app/uploads
STATIC_FILES_DIR=
SEED_DEV_USERS=false
