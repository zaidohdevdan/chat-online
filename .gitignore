# Variáveis de ambiente e segredos (nunca versionar)
.env
.env.*
!.env.example
**/frontend/.env
**/frontend/.env.*

# Dependências e builds do Frontend (Node / Vite / TypeScript)
node_modules/
frontend/node_modules/
dist/
frontend/dist/
*.tsbuildinfo
frontend/*.tsbuildinfo
.vite/
frontend/.vite/
coverage/
