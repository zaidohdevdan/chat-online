# Binários e artefatos de compilação/teste do Go
bin/
/chat-api
/userctl
/api
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.txt

# Dados locais de execução e uploads
/.data/
/uploads/

# Diretórios de plataformas de deploy
.vercel/
frontend/.vercel/
.railway/

# Logs e arquivos temporários de sistema/IDE
